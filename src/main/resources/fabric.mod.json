{
    "schemaVersion": 1,
    "id": "bclib",
    "version": "26.301.1",
    "name": "BCLib",
    "description": "A library for BetterX team mods",
    "authors": [
        "Quiqueck",
        "paulevs",
        "Bulldog83"
    ],
    "contact": {
        "homepage": "https://modrinth.com/mod/bclib",
